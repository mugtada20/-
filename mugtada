# --- 3. إدارة الحالة (Session State) ---
if 'level' not in st.session_state:
    st.session_state.level = 0
if 'player_name' not in st.session_state:
    st.session_state.player_name = ""

# --- 4. دالة الكتابة (الراوي) ---
def narrator_speak(text):
    text = text.format(name=st.session_state.player_name) # إضافة اسم اللاعب للنص
    placeholder = st.empty()
    full_text = ""
    for char in text:
        full_text += char
        placeholder.markdown(f"<div style='font-size:20px; text-align:right;'>{full_text}</div>", unsafe_allow_html=True)
        time.sleep(0.02)
    return placeholder

# --- 5. منطق اللعبة الرئيسي ---

# الشاشة الرئيسية (Level 0)
if st.session_state.level == 0:
    st.title("📺 صدى الصمت: العودة")
    st.image("https://media.istockphoto.com/id/1191001701/photo/scary-hospital-corridor-with-abandoned-wheelchair.jpg?s=612x612&w=0&k=20&c=Lny0lYn0u6O_F0yWd47E-lMh64_J7J4J2ZZ5Z6Z6Z6w=") # صورة غلاف مرعبة (رابط مثال)
    st.markdown("---")
    
    col1, col2 = st.columns(2)
    with col1:
        language = st.selectbox("اللغة", ["العربية", "English"])
    with col2:
        audio = st.checkbox("تشغيل الموسيقى", value=True)

    name_input = st.text_input("📝 سجل اسمك لتبدأ القصة:", placeholder="اكتب اسمك هنا...")
    
    if st.button("🔥 ابدأ اللعبة"):
        if name_input:
            st.session_state.player_name = name_input
            st.session_state.level = 1
            st.rerun()
        else:
            st.error("الرجاء كتابة الاسم أولاً!")

# شاشة الموت (Game Over)
elif st.session_state.level == "death":
    st.error("💀 لقد قُتلت...")
    st.write("كان قراراً خاطئاً.. انتهت قصتك هنا.")
    if st.button("🔄 حاول مرة أخرى"):
        st.session_state.level = 0
        st.rerun()

# شاشة اللعب (المراحل 1-30)
else:
    lvl = st.session_state.level
    
    # جلب بيانات المرحلة الحالية
    if lvl in game_data:
        data = game_data[lvl]
        
        # العنوان
        st.header(data["title"])
        
        # الصورة (الأيقونة الكبيرة)
        st.markdown(f"<h1 style='text-align: center; font-size: 80px;'>{data['img']}</h1>", unsafe_allow_html=True)
        
        # نص الراوي
        narrator_speak(data["text"])
        
        st.markdown("---")
        
        # عرض الخيارات
        cols = st.columns(len(data["options"]))
        i = 0
        for option_text, next_level in data["options"].items():
            with cols[i]:
                if st.button(option_text):
                    st.session_state.level = next_level
                    st.rerun()
            i += 1
    else:
        st.error("حدث خطأ في تحميل المرحلة!")
        if st.button("عودة"):
            st.session_state.level = 0
            st.rerun()
